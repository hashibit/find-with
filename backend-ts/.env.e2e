NODE_ENV=test
PORT=14607

DATABASE_URL=postgresql://e2e:e2e@localhost:14600/findwith_e2e
REDIS_URL=redis://localhost:14601

S3_BUCKET=findwith-test
S3_ACCESS_KEY_ID=e2ekey
S3_SECRET_ACCESS_KEY=e2esecret
S3_ENDPOINT=http://localhost:14602
S3_REGION=us-east-1

# Mock services — see docker-compose.mock.yml. Backend talks to real adapters
# (ClerkAuthAdapter, StripePaymentAdapter) pointed at these local mocks.
OPENAI_BASE_URL=http://localhost:14801/v1
OPENAI_API_KEY=e2e-test-key
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small

# Clerk → mocks/clerk. JWKS served locally; mock signs JWTs with the matching private key.
CLERK_SECRET_KEY=mock_clerk_secret_unused_in_e2e
CLERK_JWKS_URL=http://localhost:14803/.well-known/jwks.json

# Stripe → mocks/stripe. STRIPE_MOCK_URL redirects the Stripe SDK to the local mock.
STRIPE_SECRET_KEY=sk_test_mock_e2e_key
STRIPE_WEBHOOK_SECRET=whsec_mock_e2e_secret
STRIPE_MOCK_URL=http://localhost:14802

# Svix webhook secret (Clerk events) — unused unless a webhook is exercised.
SVIX_SIGNING_SECRET=mock_svix_signing_secret_unused

# Fixed test crypto keys — DB is ephemeral, no rotation concern
CRYPTO_KEK=+zWr97PB/jB86Ve/6B0FPhAwbP8+p3eJHUyXYiyG1xw=
CRYPTO_DEK_CIPHERTEXT=YvWUojL5KTGXM93cxxuSsrWUTn3V8iwidf1t7JrzSmp16E6QFWn0LAT5vd/VayQ2Y2XjIJw3GgCvc7k7

CORS_ORIGINS=http://localhost:14800,http://localhost:14606,http://localhost:3001
SENTRY_DSN=

ADMIN_SECRET=e2e_admin_secret_at_least_32_characters_long
