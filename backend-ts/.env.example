PORT=14607
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:14600/findwith

# Redis
REDIS_URL=redis://localhost:14601

# S3 / MinIO
S3_BUCKET=findwith-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:14602
S3_REGION=us-east-1

# LLM providers
# For local dev, route to mock-llm (docker-compose.dev.yml port 14609):
OPENAI_API_KEY=dev-mock-key
OPENAI_BASE_URL=http://localhost:14609/v1
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=none
ANTHROPIC_API_KEY=sk-ant-...

# Clerk auth
# For local dev use mocks/clerk: CLERK_JWKS_URL=http://localhost:14611/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Stripe billing
# For local dev set STRIPE_MOCK_URL=http://localhost:14610 to route SDK calls to mocks/stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MOCK_URL=http://localhost:14610

# Svix webhook verification
SVIX_SIGNING_SECRET=...

# Sentry (optional)
SENTRY_DSN=

# Field-level encryption (AES-256-GCM envelope)
# Generate with: node -e "require('./dist/scripts/generate-keys')"
CRYPTO_KEK=<base64 32-byte key>
CRYPTO_DEK_CIPHERTEXT=<base64 nonce+ciphertext>

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:14606,chrome-extension://your-ext-id
