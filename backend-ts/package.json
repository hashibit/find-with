{
  "name": "@findwith/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --builder swc --watch",
    "start:debug": "nest start --builder swc --watch --debug",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config test/vitest.integration.config.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "sh -c 'tsx ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts \"$1\" && sed -i \"\" \"s/import { MigrationInterface, QueryRunner }/import { type MigrationInterface, type QueryRunner }/\" src/database/migrations/*.ts' --",
    "migration:run": "pnpm run typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@sentry/nestjs": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0",
    "@sinclair/typebox": "^0.33.0",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "jose": "^5.0.0",
    "mammoth": "^1.8.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-zod": "^5.4.0",
    "nunjucks": "^3.2.4",
    "openai": "^4.55.0",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^16.2.0",
    "svix": "^1.30.0",
    "typeorm": "^0.3.20",
    "ulid": "^2.3.0",
    "unpdf": "^0.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@testcontainers/postgresql": "^10.11.0",
    "@testcontainers/redis": "^10.11.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "testcontainers": "^10.11.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
