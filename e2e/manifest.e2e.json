{
  "key": "",
  "host_permissions": [
    "https://api.findwith.com/*",
    "https://*.linkedin.com/*",
    "https://mail.google.com/*",
    "http://localhost:14607/*",
    "http://localhost:14800/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "http://localhost:14800/linkedin-*.html"
      ],
      "js": ["cs-linkedin-job.js"]
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*/easy-apply/*",
        "https://www.linkedin.com/jobs/search/*"
      ],
      "js": ["cs-linkedin-apply.js"]
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "http://localhost:14800/gmail-*.html"
      ],
      "js": ["cs-gmail.js"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://findwith.com/*",
      "http://localhost:14606/*",
      "http://localhost:14607/*"
    ]
  }
}
